---
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/700.css';
import '@fontsource/great-vibes/400.css';
import '@fontsource-variable/inter';
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Cormorant Garamond';
    --aw-font-heading: 'Cormorant Garamond';
    --aw-font-script: 'Great Vibes';

    --aw-color-primary: rgb(139 169 181);
    --aw-color-secondary: rgb(109 139 151);
    --aw-color-accent: rgb(74 103 115);

    --aw-color-text-heading: rgb(51 65 72);
    --aw-color-text-default: rgb(55 65 72);
    --aw-color-text-muted: rgb(55 65 72 / 66%);
    --aw-color-bg-page: rgb(250 248 245);

    --aw-color-bg-page-dark: rgb(45 62 72);

    ::selection {
      background-color: rgb(139 169 181 / 30%);
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Cormorant Garamond';
    --aw-font-heading: 'Cormorant Garamond';
    --aw-font-script: 'Great Vibes';

    --aw-color-primary: rgb(139 169 181);
    --aw-color-secondary: rgb(109 139 151);
    --aw-color-accent: rgb(74 103 115);

    --aw-color-text-heading: rgb(237 241 243);
    --aw-color-text-default: rgb(220 228 232);
    --aw-color-text-muted: rgb(220 228 232 / 66%);
    --aw-color-bg-page: rgb(45 62 72);

    ::selection {
      background-color: rgb(139 169 181 / 40%);
      color: snow;
    }
  }

  .font-script {
    font-family: var(--aw-font-script), cursive;
  }
</style>
