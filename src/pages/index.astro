---
import Layout from '~/layouts/PageLayout.astro';
import { providers } from '~/data/providers';

const metadata = {
  title: 'Beau Monde Salon Suites | Luxury Salon in Holly Springs, NC',
  ignoreTitleTemplate: true,
};

const testimonials = [
  {
    text: "Chris Phillips gave me a great haircut. Yesterday was my first visit with her, but definitely not my last. The studio is new, clean, and beautiful with easy parking. They're careful, too: masks required. I recommend 100%.",
    name: 'Jenny Kotora-Lynch',
  },
  {
    text: "One stylist couldn't fit me in on short notice, but found another stylist that could. WOW! Gotta love women supporting women! I came out with a fabulous haircut and a new salon.",
    name: 'Tiffany Munro',
  },
  {
    text: 'This place is SO clean and cute. Chris did an amazing job on my hair and I will definitely be coming for every hair appointment! Great location and everyone there was super nice.',
    name: 'Mersina Boynton',
  },
];

const galleryImages = [
  'https://images.unsplash.com/photo-1560066984-138dadb4c035?w=600&h=400&fit=crop',
  'https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=600&h=400&fit=crop',
  'https://images.unsplash.com/photo-1521590832167-7bcbfaa6381f?w=600&h=400&fit=crop',
  'https://images.unsplash.com/photo-1559599101-f09722fb4948?w=600&h=400&fit=crop',
  'https://images.unsplash.com/photo-1562322140-8baeececf3df?w=600&h=400&fit=crop',
  'https://images.unsplash.com/photo-1633681926022-84c23e8cb2d6?w=600&h=400&fit=crop',
];
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <section class="relative w-full h-[70vh] min-h-[500px] overflow-hidden">
    <div class="grid grid-cols-3 h-full">
      <div class="relative overflow-hidden">
        <img
          src="https://images.unsplash.com/photo-1581403341630-a6e0b9d2d257?w=600&h=900&fit=crop&crop=face"
          alt="Salon client"
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>
      <div class="relative overflow-hidden">
        <img
          src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=600&h=900&fit=crop&crop=face"
          alt="Beauty professional"
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>
      <div class="relative overflow-hidden">
        <img
          src="https://images.unsplash.com/photo-1503951914875-452162b0f3f1?w=600&h=900&fit=crop&crop=face"
          alt="Salon client"
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>
    </div>
    <!-- Overlay with logo -->
    <div class="absolute inset-0 flex items-center justify-center">
      <div class="text-center">
        <h1 class="font-script text-6xl md:text-8xl lg:text-9xl text-[rgb(74_103_115)] drop-shadow-[0_2px_10px_rgba(255,255,255,0.8)]">
          Beau Monde
        </h1>
        <p class="text-lg md:text-2xl tracking-[0.4em] uppercase text-[rgb(74_103_115)] mt-2 drop-shadow-[0_1px_5px_rgba(255,255,255,0.8)]">
          Salon Suites
        </p>
      </div>
    </div>
    <!-- Decorative bottom bar -->
    <div class="absolute bottom-0 left-0 right-0 h-16 bg-[rgb(139_169_181)] opacity-60"></div>
  </section>

  <!-- Salon Suite Professionals -->
  <section class="py-16 md:py-24 bg-[rgb(250_248_245)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <h2 class="font-script text-4xl md:text-6xl text-[rgb(139_169_181)] mb-4">
          Salon Suite Professionals
        </h2>
        <p class="text-lg text-muted font-serif max-w-2xl mx-auto">
          Schedule your services directly through our variety of independent providers.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
        {providers.filter((p, i, arr) => arr.findIndex(x => x.slug === p.slug) === i).map((provider) => (
          <a
            href={`/providers/${provider.slug}`}
            class="group relative aspect-square overflow-hidden rounded-sm"
          >
            <img
              src={provider.image}
              alt={provider.name}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-[rgb(74_103_115)]/0 group-hover:bg-[rgb(74_103_115)]/70 transition-all duration-300 flex items-center justify-center">
              <div class="text-white text-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 px-2">
                <p class="font-serif font-semibold text-lg">{provider.name}</p>
                <p class="text-sm text-white/80 mt-1">{provider.business !== provider.name ? provider.business : ''}</p>
                <p class="text-xs tracking-wider uppercase mt-2 border border-white/50 inline-block px-3 py-1">
                  Schedule Now
                </p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Experience the Luxury -->
  <section class="py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <h2 class="font-script text-4xl md:text-6xl text-[rgb(74_103_115)] mb-8">
          Experience the Luxury
        </h2>
        <p class="text-lg text-muted font-serif leading-relaxed max-w-3xl mx-auto">
          Beau Monde Salon Suites is a locally-owned, luxury salon with the area's top beauty professionals.
        </p>
        <p class="text-lg text-muted font-serif leading-relaxed max-w-3xl mx-auto mt-4">
          Each bright and airy suite is home to amazing stylists, aestheticians, brow specialists, nail artists, and aesthetic medical practitioners.
        </p>
        <p class="text-lg text-muted font-serif italic mt-6">
          Make a day of it!
        </p>
        <p class="text-lg text-muted font-serif leading-relaxed max-w-3xl mx-auto mt-4">
          Beau Monde is located in the heart of the Holly Springs Village District, offering fine restaurants, boutique shopping, and ample parking, all just steps away from the salon.
        </p>
      </div>
    </div>

    <!-- Photo Gallery -->
    <div class="overflow-hidden mt-12">
      <div class="flex gap-4 px-4 overflow-x-auto pb-4 snap-x snap-mandatory scrollbar-hide">
        {galleryImages.map((src, i) => (
          <div class="flex-none w-72 md:w-96 snap-center">
            <img
              src={src}
              alt={`Beau Monde Salon Suites interior ${i + 1}`}
              class="w-full h-64 md:h-80 object-cover rounded-sm"
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Join CTA -->
  <section class="py-16 md:py-20 bg-[rgb(250_248_245)]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="font-serif text-2xl md:text-3xl text-[rgb(74_103_115)] leading-relaxed italic">
        Join the Beau Monde Salon Suites collection of qualified professionals and become a leader in the Beauty industry.
      </h2>
      <a
        href="/salon-professionals"
        class="inline-block mt-8 font-script text-3xl text-[rgb(74_103_115)] underline underline-offset-8 decoration-1 hover:text-[rgb(139_169_181)] transition-colors"
      >
        Learn More
      </a>
    </div>
  </section>

  <!-- Customer Reviews -->
  <section class="py-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <h2 class="font-script text-4xl md:text-6xl text-[rgb(139_169_181)] text-center mb-12">
        Customer Reviews
      </h2>
    </div>
  </section>

  <section class="bg-[rgb(139_169_181)] py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {testimonials.map((t) => (
          <div class="bg-white rounded-sm p-8 md:p-10 text-center">
            <!-- Quote marks -->
            <div class="text-[rgb(139_169_181)] text-6xl font-serif leading-none mb-4">&ldquo;</div>
            <p class="text-muted font-serif text-base leading-relaxed">
              {t.text}
            </p>
            <p class="font-script text-xl text-[rgb(74_103_115)] mt-6">
              {t.name}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
